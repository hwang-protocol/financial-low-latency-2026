# Exact latency-relevant lines required in the packaged Chapter 06 F-Stack INI.
# The verifier matches these lines byte-for-byte against the runtime artifact.
lcore_mask=4
memory=256
idle_sleep=0
pkt_tx_delay=0
allow=03:00.0
hz=100
net.inet.tcp.sendspace=16384
net.inet.tcp.recvspace=8192
net.inet.tcp.delayed_ack=1
