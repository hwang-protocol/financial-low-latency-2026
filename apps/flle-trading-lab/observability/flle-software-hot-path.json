{
  "annotations": {"list": []},
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1, "type": "stat", "title": "本轮固定样本",
      "description": "MANUAL C++ 当前 measurement generation 的样本数；每轮实验应为 200。",
      "datasource": {"type": "prometheus", "uid": "flle-prometheus"},
      "targets": [{"refId": "A", "expr": "flle_software_measurement_samples{client=\"manual\"}", "legendFormat": "{{mode}} · {{placement}}"}],
      "fieldConfig": {"defaults": {"decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 200}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0}
    },
    {
      "id": 2, "type": "stat", "title": "队列 → 发送 P99",
      "description": "从订单进入 C++ 线程交接队列，到 order thread 发出 OUCH O。",
      "datasource": {"type": "prometheus", "uid": "flle-prometheus"},
      "targets": [{"refId": "A", "expr": "flle_software_queue_to_send_seconds{client=\"manual\",stat=\"p99\"}", "legendFormat": "{{mode}} · {{placement}}"}],
      "fieldConfig": {"defaults": {"decimals": 3, "unit": "s"}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "center", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0}
    },
    {
      "id": 3, "type": "stat", "title": "发送 → 最终结果 P99",
      "description": "第四章已经建立的 OUCH send-to-final RTT；用作控制项。",
      "datasource": {"type": "prometheus", "uid": "flle-prometheus"},
      "targets": [{"refId": "A", "expr": "flle_baseline_order_rtt_seconds{client=\"manual\",stat=\"p99\"}", "legendFormat": "OUCH RTT"}],
      "fieldConfig": {"defaults": {"decimals": 3, "unit": "s"}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "center", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0}
    },
    {
      "id": 4, "type": "stat", "title": "入队 → 最终结果 P99",
      "description": "软件交接和订单网络往返的总和；不是端到端行情反应时间。",
      "datasource": {"type": "prometheus", "uid": "flle-prometheus"},
      "targets": [{"refId": "A", "expr": "flle_software_submit_to_final_seconds{client=\"manual\",stat=\"p99\"}", "legendFormat": "{{mode}} · {{placement}}"}],
      "fieldConfig": {"defaults": {"decimals": 3, "unit": "s"}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "center", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0}
    },
    {
      "id": 5, "type": "timeseries", "title": "线程交接尾部：一次只换一个 profile",
      "description": "同一真实 MANUAL 下单路径、同样 20 warmup + 200 measured、50 Hz；标签保留 mode 与 placement。",
      "datasource": {"type": "prometheus", "uid": "flle-prometheus"},
      "targets": [
        {"refId": "A", "expr": "flle_software_queue_to_send_seconds{client=\"manual\",stat=\"p50\"}", "legendFormat": "{{mode}} / {{placement}} p50"},
        {"refId": "B", "expr": "flle_software_queue_to_send_seconds{client=\"manual\",stat=\"p99\"}", "legendFormat": "{{mode}} / {{placement}} p99"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "line", "lineInterpolation": "stepAfter", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": false}}, "overrides": []},
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "gridPos": {"h": 10, "w": 16, "x": 0, "y": 5}
    },
    {
      "id": 6, "type": "stat", "title": "Order thread 与 RX CPU",
      "description": "蓝色是 order thread 最近运行 CPU，绿色是订单 socket 最近收包 CPU；相等只说明最近一次位置重合。",
      "datasource": {"type": "prometheus", "uid": "flle-prometheus"},
      "targets": [
        {"refId": "A", "expr": "flle_order_thread_cpu{client=\"manual\"}", "legendFormat": "order thread"},
        {"refId": "B", "expr": "flle_order_rx_cpu{client=\"manual\"}", "legendFormat": "socket RX"}
      ],
      "fieldConfig": {"defaults": {"decimals": 0}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "vertical", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "gridPos": {"h": 10, "w": 8, "x": 16, "y": 5}
    },
    {
      "id": 7, "type": "timeseries", "title": "完整软件段与网络段",
      "description": "蓝线是 queue ingress 到 final；灰线是 OUCH send 到 final。两者相减才近似本章新增的软件交接段。",
      "datasource": {"type": "prometheus", "uid": "flle-prometheus"},
      "targets": [
        {"refId": "A", "expr": "flle_software_submit_to_final_seconds{client=\"manual\",stat=\"p99\"}", "legendFormat": "总段 {{mode}} / {{placement}} p99"},
        {"refId": "B", "expr": "flle_baseline_order_rtt_seconds{client=\"manual\",stat=\"p99\"}", "legendFormat": "OUCH RTT p99"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "line", "lineInterpolation": "stepAfter", "lineWidth": 2, "fillOpacity": 7, "showPoints": "never"}}, "overrides": []},
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "gridPos": {"h": 8, "w": 16, "x": 0, "y": 15}
    },
    {
      "id": 8, "type": "stat", "title": "队列当前深度",
      "description": "固定 50 Hz 实验结束后应回到 0；非零意味着尚有订单未被 order thread 取走。",
      "datasource": {"type": "prometheus", "uid": "flle-prometheus"},
      "targets": [{"refId": "A", "expr": "flle_order_queue_depth{client=\"manual\"}", "legendFormat": "{{mode}}"}],
      "fieldConfig": {"defaults": {"decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "vertical", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 15}
    }
  ],
  "refresh": "2s",
  "schemaVersion": 41,
  "tags": ["FLLE", "host-native", "software-hot-path"],
  "templating": {"list": []},
  "time": {"from": "now-30m", "to": "now"},
  "timezone": "browser",
  "title": "FLLE · C++ 软件热路径",
  "uid": "flle-software-hot-path",
  "version": 1
}
