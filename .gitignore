/artifacts/blobs/x2522/ch05-four-path/v12/*
!/artifacts/blobs/x2522/ch05-four-path/v12/BUILD-PROVENANCE.json
!/artifacts/blobs/x2522/ch05-four-path/v12/flle-ch05-four-path-v12-source.tgz
!/artifacts/blobs/x2522/ch05-four-path/v12/flle-ch05-four-path-v12-x86_64-jammy-runtime.tgz
