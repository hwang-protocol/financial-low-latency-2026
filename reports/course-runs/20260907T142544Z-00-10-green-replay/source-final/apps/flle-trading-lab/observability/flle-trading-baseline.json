{
  "annotations": {"list": []},
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "在线组件",
      "description": "四个组件都在线时为 4；它不代表交易语义一定正确。",
      "datasource": {"type": "prometheus", "uid": "flle-prometheus"},
      "targets": [{"refId": "A", "expr": "sum(flle_component_up)", "legendFormat": "ONLINE"}],
      "fieldConfig": {"defaults": {"decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 4}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "行情回放进度",
      "datasource": {"type": "prometheus", "uid": "flle-prometheus"},
      "targets": [{"refId": "A", "expr": "flle_replay_progress_ratio", "legendFormat": "进度"}],
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}, {"color": "green", "value": 0.8}]}}, "overrides": []},
      "options": {"minVizHeight": 75, "minVizWidth": 75, "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "showThresholdLabels": false, "showThresholdMarkers": true, "sizing": "auto"},
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "实时行情速率",
      "datasource": {"type": "prometheus", "uid": "flle-prometheus"},
      "targets": [{"refId": "A", "expr": "rate(flle_market_messages_total[30s])", "legendFormat": "ITCH msg/s"}],
      "fieldConfig": {"defaults": {"decimals": 0, "unit": "ops"}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "center", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "AUTO 订单 RTT P99",
      "description": "C++ AUTO 进程从发送 OUCH O 到收到最终 E/J 的当前轮次摘要。",
      "datasource": {"type": "prometheus", "uid": "flle-prometheus"},
      "targets": [{"refId": "A", "expr": "flle_order_rtt_seconds{client=\"auto\",stat=\"p99\"}", "legendFormat": "P99"}],
      "fieldConfig": {"defaults": {"decimals": 3, "unit": "s"}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "center", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "C++ 订单 RTT",
      "description": "AUTO 是当前轮次展示摘要；MANUAL baseline 只使用最近一次固定测量 generation。网页和 Python 均不在计时区间内。",
      "datasource": {"type": "prometheus", "uid": "flle-prometheus"},
      "targets": [
        {"refId": "A", "expr": "flle_order_rtt_seconds{client=\"auto\",stat=\"p50\"}", "legendFormat": "AUTO p50"},
        {"refId": "B", "expr": "flle_order_rtt_seconds{client=\"auto\",stat=\"p99\"}", "legendFormat": "AUTO p99"},
        {"refId": "C", "expr": "flle_baseline_order_rtt_seconds{client=\"manual\",stat=\"p99\"}", "legendFormat": "MANUAL baseline p99"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": false}}, "overrides": []},
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "gridPos": {"h": 10, "w": 16, "x": 0, "y": 5}
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Feed Handler 状态",
      "description": "pending 或 gap 非零时，先查行情连续性；duplicates 在双路模式下增长是预期现象。",
      "datasource": {"type": "prometheus", "uid": "flle-prometheus"},
      "targets": [
        {"refId": "A", "expr": "flle_feed_pending_messages", "legendFormat": "pending"},
        {"refId": "B", "expr": "flle_feed_gap_messages", "legendFormat": "gap"},
        {"refId": "C", "expr": "flle_feed_duplicates", "legendFormat": "duplicate"}
      ],
      "fieldConfig": {"defaults": {"decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "vertical", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "gridPos": {"h": 10, "w": 8, "x": 16, "y": 5}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "订单与成交速率",
      "datasource": {"type": "prometheus", "uid": "flle-prometheus"},
      "targets": [
        {"refId": "A", "expr": "rate(flle_paper_orders_total{client=\"auto\"}[1m])", "legendFormat": "AUTO orders/s"},
        {"refId": "B", "expr": "rate(flle_paper_orders_total{client=\"manual\"}[1m])", "legendFormat": "MANUAL orders/s"},
        {"refId": "C", "expr": "rate(flle_paper_fills_total{client=\"auto\"}[1m])", "legendFormat": "AUTO fills/s"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops", "custom": {"drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never"}}, "overrides": []},
      "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 15}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "RTT 样本累计",
      "datasource": {"type": "prometheus", "uid": "flle-prometheus"},
      "targets": [
        {"refId": "A", "expr": "flle_order_rtt_samples{client=\"auto\"}", "legendFormat": "AUTO samples"},
        {"refId": "B", "expr": "flle_baseline_order_rtt_samples{client=\"manual\"}", "legendFormat": "MANUAL baseline samples"}
      ],
      "fieldConfig": {"defaults": {"decimals": 0, "custom": {"drawStyle": "line", "lineInterpolation": "stepAfter", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never"}}, "overrides": []},
      "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 15}
    }
  ],
  "refresh": "2s",
  "schemaVersion": 41,
  "tags": ["FLLE", "host-native", "trading"],
  "templating": {"list": []},
  "time": {"from": "now-15m", "to": "now"},
  "timezone": "browser",
  "title": "FLLE · 普通 Linux 交易基线",
  "uid": "flle-trading-baseline",
  "version": 1
}
